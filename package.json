{
  "name": "lumiverse-looking-glass",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:backend": "bun build src/backend.ts --outfile dist/backend.js --target bun",
    "build:frontend": "bun build src/frontend.ts --outfile dist/frontend.js --target browser",
    "build": "bun run build:backend && bun run build:frontend",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "lumiverse-spindle-types": "0.5.17",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/marked": "^6.0.0",
    "dompurify": "^3.4.16",
    "marked": "^18.0.3"
  }
}
